# Copy to backend/.env and fill in. .env is gitignored — never commit it.
# AWS credentials come from `aws configure`, not from here.

# Google Places — nearby diagnostic labs
GOOGLE_PLACES_API_KEY=

# Google Calendar — slot holds. AWS has no calendar service, so this stays Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Amazon SES. In sandbox these must all be verified identities.
SES_SENDER=
SES_LAB_RECIPIENT=
SES_DOCTOR_RECIPIENT=

# Set to 1 to build emails without handing them to SES.
NANI_DRY_RUN=
